{
  "info": {
    "name": "MenteConecta - Módulo 1 (Auth)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden (Collection Runner) con el backend corriendo. Cada petición trae pruebas (pestaña Tests). Contraseña de ejemplo solo para pruebas locales."
  },
  "item": [
    {
      "name": "1. Registro",
      "item": [
        {
          "name": "1.1 Registro correcto (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Pérez\",\n  \"correo\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correo único por ejecución para poder repetir la prueba sin limpiar la base.",
                  "pm.collectionVariables.set('email', 'postman.' + Date.now() + '@correo.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('Mensaje y usuario según contrato', () => {",
                  "  pm.expect(b.message).to.eql('Cuenta creada correctamente');",
                  "  pm.expect(b.user).to.have.all.keys('idUsuario', 'nombre', 'correo');",
                  "  pm.expect(b.user.correo).to.eql(pm.collectionVariables.get('email'));",
                  "});",
                  "pm.test('Devuelve token y NO devuelve passwordHash ni password', () => {",
                  "  pm.expect(b.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(pm.response.text()).to.not.match(/passwordHash|\"password\"/i);",
                  "});",
                  "pm.collectionVariables.set('token', b.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Correo duplicado en MAYÚSCULAS (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Pérez\",\n  \"correo\": \"{{emailUpper}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('emailUpper', pm.collectionVariables.get('email').toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('No entrega token', () => pm.expect(pm.response.json().token).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Datos inválidos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"A\",\n  \"correo\": \"no-es-correo\",\n  \"password\": \"corta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Errores por campo', () => pm.expect(pm.response.json().errors).to.have.all.keys('nombre', 'correo', 'password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Contraseña de 11 caracteres (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Pérez\",\n  \"correo\": \"otra.{{$timestamp}}@correo.com\",\n  \"password\": \"Abcdefghij1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400: mínimo 12 caracteres', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().errors.password).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Inicio de sesión",
      "item": [
        {
          "name": "2.1 Login correcto (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Mensaje, usuario y token', () => {",
                  "  pm.expect(b.message).to.eql('Inicio de sesión correcto');",
                  "  pm.expect(b.user).to.have.all.keys('idUsuario', 'nombre', 'correo');",
                  "  pm.expect(b.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('Sin passwordHash', () => pm.expect(pm.response.text()).to.not.match(/passwordHash/i));",
                  "pm.collectionVariables.set('token', b.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Contraseña incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{email}}\",\n  \"password\": \"UnaClaveIncorrecta999!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje genérico', () => pm.expect(pm.response.json().message).to.eql('Correo o contraseña incorrectos.'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Correo inexistente (401, mismo mensaje)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"no.existe.{{$timestamp}}@correo.com\",\n  \"password\": \"UnaClaveIncorrecta999!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Mismo mensaje que con contraseña incorrecta', () => pm.expect(pm.response.json().message).to.eql('Correo o contraseña incorrectos.'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Cuerpo inválido (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"no-es-correo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Usuario autenticado (/me)",
      "item": [
        {
          "name": "3.1 /me con token válido (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Solo idUsuario, nombre y correo', () => pm.expect(pm.response.json().user).to.have.all.keys('idUsuario', 'nombre', 'correo'));",
                  "pm.test('Sin passwordHash', () => pm.expect(pm.response.text()).to.not.match(/passwordHash/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 /me sin token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 /me con token alterado (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}x"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 /me ignora idUsuario en la query (200, id del token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me?idUsuario=999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ],
              "query": [
                {
                  "key": "idUsuario",
                  "value": "999999"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve el usuario del token, no el 999999', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.idUsuario).to.not.eql(999999);",
                  "  pm.expect(pm.response.json().user.correo).to.eql(pm.collectionVariables.get('email'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "password",
      "value": "UnaClaveSegura123!"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "emailUpper",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}