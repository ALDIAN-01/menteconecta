# Copia este archivo a ".env" (en la carpeta backend/) y ajusta los valores.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Mac/Linux:             cp .env.example .env
# NUNCA subas ".env" a GitHub. Este archivo (.env.example) NO debe contener secretos reales.

# ---------- Servidor ----------
NODE_ENV=development
PORT=3000
# Origen EXACTO del frontend permitido por CORS (sin "/" final).
CORS_ORIGIN=http://localhost:5173

# ---------- SQL Server local ----------
# Servidor: "localhost" casi siempre sirve. NO escribas "localhost\SQLEXPRESS" aquí;
# el nombre de instancia va en DB_INSTANCE (ver README).
DB_SERVER=localhost
# Puerto TCP. Instancia por defecto = 1433. Se IGNORA si defines DB_INSTANCE.
DB_PORT=1433
# Solo si usas una instancia con nombre (ej. SQLEXPRESS). Déjalo vacío si no aplica.
# Requiere el servicio "SQL Server Browser" activo. Si no, usa DB_PORT con el puerto fijo.
DB_INSTANCE=
DB_NAME=MenteConecta
# Autenticación SQL (login/contraseña de SQL Server). Ver README para crearlos.
DB_USER=menteconecta_app
DB_PASSWORD=PonAquiUnaClaveLarga
# En desarrollo local con certificado autofirmado: ENCRYPT=true y TRUST_SERVER_CERT=true.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# ---------- Seguridad ----------
# OBLIGATORIO: mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=5ef03cb8b997b5f8c13acfbed548069f410cb525af5a9104c9e0664d240effdf9dea193a8ffe5138a2955d3924ee2455
# Duración del token (formato de jsonwebtoken: 15m, 2h, 1d...).
JWT_EXPIRES_IN=2h
# Costo de bcrypt (el contrato permite 10 a 12).
BCRYPT_COST=12
# Límite de intentos por IP sobre /api/auth/login y /api/auth/register en 15 minutos.
AUTH_RATE_LIMIT_MAX=20
